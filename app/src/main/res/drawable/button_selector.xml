<?xml version="1.0" encoding="utf-8"?>
<!-- Floating back button drawn over other apps. A translucent MG4 surface instead of the
     old PNG pair: it has to read against whatever app is underneath, so it stays subtle at
     rest and brightens on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ev_pressed_strong">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ev_corner" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ev_corner" />
            <solid android:color="@color/ev_surface_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/ev_pressed" />
        </shape>
    </item>
</ripple>
