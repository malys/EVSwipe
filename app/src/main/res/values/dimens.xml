<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MG4 suite tokens (same values as MG4Tasker). Vehicle screen: ~10 inches, ~70 cm
         from the driver, used while driving. Everything is larger than on a hand-held phone. -->
    <dimen name="touch_target">64dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <dimen name="text_title">24sp</dimen>
    <dimen name="text_body">18sp</dimen>
    <dimen name="text_secondary">15sp</dimen>
    <dimen name="text_label">14sp</dimen>

    <!-- Corner radius shared by every MG4 surface. -->
    <dimen name="mg4_corner">12dp</dimen>

    <!-- Swipe-launcher specific: the settings screen is a wide landscape form, and the
         app list is read at a glance, so its rows are larger than the suite body size. -->
    <dimen name="settings_side_margin">200dp</dimen>
    <dimen name="settings_heading">30sp</dimen>
    <dimen name="app_row_icon">92dp</dimen>
    <dimen name="app_row_label">26sp</dimen>
    <dimen name="help_strip_height">40dp</dimen>
</resources>
