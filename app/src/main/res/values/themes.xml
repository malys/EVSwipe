<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark theme imposed, not "follow the system": the screen faces the driver at night.
         A light background filling the windscreen is glare, not a preference. Same call
         MG4Tasker made, and the reason values-night/ and the day/night PNG art are gone. -->
    <style name="Theme.MG4SwipeNovaLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mg4_accent</item>
        <item name="colorOnPrimary">@color/mg4_on_accent</item>
        <item name="colorSurface">@color/mg4_surface</item>
        <item name="colorSurfaceContainer">@color/mg4_surface_raised</item>
        <item name="android:colorBackground">@color/mg4_background</item>
        <item name="colorError">@color/mg4_error</item>
        <item name="android:windowBackground">@color/mg4_background</item>
        <item name="android:statusBarColor">@color/mg4_background</item>
        <item name="android:navigationBarColor">@color/mg4_background</item>
    </style>

    <!-- 64 dp touch target: the finger aims badly on the road and the screen is far away.
         Minimum size used everywhere in the MG4 suite. -->
    <style name="Widget.MG4.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
    </style>

    <style name="Widget.MG4.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Settings toggles. Same touch target as the buttons: a switch that needs a precise
         tap is a switch that gets missed at 90 km/h. -->
    <style name="Widget.MG4.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/mg4_accent</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MG4.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/mg4_text_primary</item>
    </style>

    <style name="Text.MG4.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/mg4_text_secondary</item>
    </style>
</resources>
