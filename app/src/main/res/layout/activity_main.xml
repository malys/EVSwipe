<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4
     MG4Suite settings surface: a fixed control rail preserves context while the
     selected launch target remains the dominant, glanceable task. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mg4_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="@dimen/settings_rail_width"
            android:layout_height="match_parent"
            android:background="@drawable/mg4_surface_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Text.MG4.Display" />

            <TextView
                android:id="@+id/version_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textAppearance="@style/Text.MG4.Secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/section_swipe_behavior"
                android:textAppearance="@style/Text.MG4.SectionHeader" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_swap_areas"
                style="@style/Widget.MG4.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/swap_swipe_areas" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_show_loader"
                style="@style/Widget.MG4.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/show_loader" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_back_button"
                style="@style/Widget.MG4.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/hide_back_button" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/check_updates_button"
                style="@style/Widget.MG4.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_check_action" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/explanation_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/explanation_text"
                        android:textAppearance="@style/Text.MG4.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/app_picker_supporting_text"
                        android:textAppearance="@style/Text.MG4.Secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/toggle_system_apps_button"
                    style="@style/Widget.MG4.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:text="@string/show_system_apps" />
            </LinearLayout>

            <ListView
                android:id="@+id/app_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_weight="1"
                android:background="@drawable/mg4_surface_card"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/spacing_sm"
                android:listSelector="@drawable/mg4_list_selector"
                android:padding="@dimen/spacing_sm" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/help_strip_height"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView"
            style="@style/Text.MG4.SwipeGuide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/mg4_help_back"
            android:text="@string/help_swipe_back" />

        <TextView
            android:id="@+id/textView2"
            style="@style/Text.MG4.SwipeGuide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/mg4_help_open"
            android:text="@string/help_swipe_open" />
    </LinearLayout>
</LinearLayout>
