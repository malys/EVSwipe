<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen: swipe-target picker plus the behaviour toggles, on the MG4 suite dark
     theme. The two coloured strips at the bottom mark where the real swipe areas live. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mg4_background"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_side_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_md"
            android:textAppearance="@style/Text.MG4.Secondary" />

        <Button
            android:id="@+id/toggle_system_apps_button"
            style="@style/Widget.MG4.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:text="@string/show_system_apps" />

        <Button
            android:id="@+id/check_updates_button"
            style="@style/Widget.MG4.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_check_action" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_back_button"
            style="@style/Widget.MG4.Switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:text="@string/nascondi_il_bottone_indietro_utile_per_i_tagliandi"
            android:textAlignment="viewEnd" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_side_margin"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:orientation="horizontal">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_swap_areas"
            style="@style/Widget.MG4.Switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/swap_swipe_areas" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_show_loader"
            style="@style/Widget.MG4.Switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/show_loader"
            android:textAlignment="viewEnd" />
    </LinearLayout>

    <TextView
        android:id="@+id/explanation_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_side_margin"
        android:layout_marginBottom="@dimen/spacing_md"
        android:text="@string/explanation_text"
        android:textAppearance="@style/Text.MG4.Title"
        android:textSize="@dimen/settings_heading" />

    <ListView
        android:id="@+id/app_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/settings_side_margin"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:layout_weight="1"
        android:background="@drawable/mg4_surface_card"
        android:divider="@color/mg4_pressed"
        android:dividerHeight="1dp"
        android:padding="@dimen/spacing_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/help_strip_height"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/mg4_help_back"
            android:gravity="center"
            android:text="@string/help_swipe_up_here_to_go_back_this_simulate_the_physical_back_button"
            android:textColor="@color/mg4_text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/mg4_help_open"
            android:gravity="center"
            android:text="@string/help_swipe_up_here_to_open_selected_app"
            android:textColor="@color/mg4_text_primary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

</LinearLayout>
