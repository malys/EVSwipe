<?xml version="1.0" encoding="utf-8"?>
<!-- EVSuite permission gate: capability, reason and next action remain visible together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ev_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="@dimen/permission_content_width"
        android:layout_height="wrap_content"
        android:background="@drawable/ev_surface_card"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permission_setup_title"
            android:textAppearance="@style/Text.EV.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/permission_overlay_label"
            android:textAppearance="@style/Text.EV.SectionHeader" />

        <TextView
            android:id="@+id/textPermissionExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/permission_overlay_detail"
            android:textAppearance="@style/Text.EV.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/permission_next_step"
            android:textAppearance="@style/Text.EV.Secondary" />

        <Button
            android:id="@+id/buttonGrantOverlayPermission"
            style="@style/Widget.EV.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/concedi_permesso" />
    </LinearLayout>
</LinearLayout>
